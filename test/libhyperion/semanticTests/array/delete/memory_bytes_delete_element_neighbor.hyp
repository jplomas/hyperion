// `delete b[i]` on a memory byte-array element must clear exactly one byte and leave the memory
// after the buffer untouched. Prior to the MemoryByteArrayElementDeleteClearsWholeWord fix, the
// compiler wrote a full 64-byte word under the legacy code generator.
// For a delete near the end of the buffer, that word spilled past it into the next object.
//
// Layout: a `bytes` array of length `L` is rounded up to `R = 64*ceil(L/64)` bytes, occupying `[D, D+R)`
// with `P = R-L` padding bytes. `E = D+R` is the first byte past it and, under the bump allocator,
// the start of the next object. If `delete b[i]` writes a word over [D+i, D+i+63], it reaches
// past E into that object whenever i >= R-63.
//
// The spill always runs from E upward, i.e. over the most significant bytes of the next word:
// - a struct or fixed-size array holds a value there and loses its top bytes, so the struct holds a
//   `uint512`, whose every byte is significant;
// - a dynamic array holds its length there, right-aligned, so the low bytes survive and it is
//   truncated only once the element count is large enough to reach the overwritten bytes.
contract C {
    struct S { uint512 x; }

    // L=64, P=0
    function structNeighborLastElement() external pure returns (uint512) {
        bytes memory b = new bytes(64);
        S memory s = S(type(uint512).max);
        delete b[63];
        return s.x;
    }

    // L=64, P=0
    function structNeighborOneShort() external pure returns (uint512) {
        bytes memory b = new bytes(64);
        S memory s = S(type(uint512).max);
        delete b[62];
        return s.x;
    }

    // A dynamic array neighbour with a small element count keeps all of its length in the low,
    // unreachable byte E+63
    function dynArrayNeighborSurvivesSmallCount() external pure returns (uint256) {
        bytes memory b = new bytes(64);
        uint256[] memory a = new uint256[](5);
        delete b[63];
        return a.length;
    }

    // With 256 elements the length needs byte E+62
    function dynArrayNeighborTruncatesLargeCount() external pure returns (uint256) {
        bytes memory b = new bytes(64);
        uint256[] memory a = new uint256[](256);
        delete b[63];
        return a.length;
    }

    // L=1, so P=63
    function paddingImmunity() external pure returns (uint512) {
        bytes memory b = new bytes(1);
        S memory s = S(type(uint512).max);
        delete b[0];
        return s.x;
    }
}
// ----
// structNeighborLastElement() -> 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// structNeighborOneShort() -> 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
// dynArrayNeighborSurvivesSmallCount() -> 5
// dynArrayNeighborTruncatesLargeCount() -> 256
// paddingImmunity() -> 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
